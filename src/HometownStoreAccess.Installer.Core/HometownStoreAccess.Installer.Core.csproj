    <AssemblyName>HometownStoreAccess.Installer.Core</AssemblyName>
    <RootNamespace>HometownStoreAccess.Installer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HometownStoreAccess.Tests" />
  </ItemGroup>
</Project>
