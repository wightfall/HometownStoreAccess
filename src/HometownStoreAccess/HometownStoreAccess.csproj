<Project Sdk="Microsoft.NET.Sdk">
  <!-- The BepInEx plugin itself. References the game's managed assemblies directly from the
       game installation (never copied into the repository). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HometownStoreAccess</AssemblyName>
    <RootNamespace>HometownStoreAccess</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;CS0436;MSB3277</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HometownStoreAccess.Core\HometownStoreAccess.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>

    <Reference Include="Assembly-CSharp" Publicize="true"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro" Publicize="true"><HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI" Publicize="true"><HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Localization"><HintPath>$(GameManaged)\Unity.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(GameManaged)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DOTween"><HintPath>$(GameManaged)\DOTween.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GameManaged)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TilemapModule"><HintPath>$(GameManaged)\UnityEngine.TilemapModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.GridModule"><HintPath>$(GameManaged)\UnityEngine.GridModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Physics2DModule"><HintPath>$(GameManaged)\UnityEngine.Physics2DModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.LocalizationModule"><HintPath>$(GameManaged)\UnityEngine.LocalizationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(GameManaged)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\lib\prism\prism.dll" Link="prism.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Optional: copy the build straight into the game's plugin folder (dotnet build -p:DeployToGame=true). -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <PropertyGroup>
      <PluginDeployDir>$(GameDir)\BepInEx\plugins\HometownStoreAccess</PluginDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <BuiltInTranslation Include="$(MSBuildThisFileDirectory)..\..\translations\*.game.txt" />
    </ItemGroup>
    <MakeDir Directories="$(PluginDeployDir);$(PluginDeployDir)\translations" />
    <Copy SourceFiles="$(TargetDir)HometownStoreAccess.dll;$(TargetDir)HometownStoreAccess.Core.dll;$(TargetDir)prism.dll" DestinationFolder="$(PluginDeployDir)" />
    <Copy SourceFiles="@(BuiltInTranslation)" DestinationFolder="$(PluginDeployDir)\translations" />
    <Message Importance="high" Text="Deployed to $(PluginDeployDir)" />
  </Target>
</Project>
